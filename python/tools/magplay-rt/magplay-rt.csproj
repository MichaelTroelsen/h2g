<Project Sdk="Microsoft.NET.Sdk">
  <!-- MagPlaySrc: the `src` directory of a MagPlaySID checkout; override with
       dotnet build -c Release -p:MagPlaySrc=<path> -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <MagPlaySrc Condition="'$(MagPlaySrc)' == ''">C:\Users\mit\Downloads\MagPlaySID-main\MagPlaySID-main\src</MagPlaySrc>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(MagPlaySrc)\MagPlay.Transcribe\MagPlay.Transcribe.csproj" />
  </ItemGroup>
</Project>
