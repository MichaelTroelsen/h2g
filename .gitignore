# Converted songs staged by play.ps1. Deliberately not written next to the
# input: Commando.sng at the repo root is the byte-exact regression fixture.
build/

# Per-machine permission grants, written by Claude Code as they are approved.
# `.claude/settings.json` beside it is the shared allowlist and IS tracked:
# every rule there is one a fork would otherwise have to ask a human about,
# and a fork that has to ask is a fork nobody can leave running.
.claude/settings.local.json

# Agent worktrees. One checkout per concurrent agent (CLAUDE.md, "Parallel
# work"), created and pruned by the runners rather than authored. They also
# make `git status --porcelain` non-empty, which fidelity.py:3165 reads as a
# dirty tree -- so leaving them untracked stamps every generated report
# `-dirty` however clean the tracked files are.
.claude/worktrees/

# VICE monitor output, written beside the repo when a player is traced by hand.
monlog_out.txt
